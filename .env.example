# Retail Solutions Environment Configuration
# Copy this file to .env and update with your values

DB_HOST=localhost
DB_PORT=3306
DB_USER=retail_user
DB_PASS=change_me_in_production
DB_NAME=retail_solutions

# Analytics configuration
PENDO_API_KEY=your_api_key_here
PENDO_APP_ID=your_app_id_here

# Feature flags
ENABLE_ANALYTICS=true
ENABLE_LOGGING=true

# Session settings
SESSION_LIFETIME=3600
SESSION_SECURE=true
